# ============================================================
# Nakış Sitesi — ortam değişkenleri şablonu.
# `.env` olarak kopyalayıp doldurun. `.env` dosyasını ASLA commit etmeyin.
# Production değerleri sunucunun gizli değer deposundan (secret store) gelmelidir.
# Değişkenler src/server/env.ts içinde doğrulanır; hatalı değer uygulamayı açmaz.
# ============================================================

# Çalışma modu: development | test | production.
# production'da: https olmayan APP_URL, PAYMENT_SIMULATION_ENABLED=true ve PAYMENT_PROVIDER=simulated REDDEDİLİR.
NODE_ENV=development
# Sitenin tam adresi (CSRF Origin kontrolü ve e-posta bağlantıları bunu kullanır). Production'da https:// zorunlu.
APP_URL=http://localhost:3000

# --- Veritabanı (PostgreSQL 17; docker compose host portu 5433'e bağlar) ---
# Ana veritabanı bağlantısı. CHANGE_ME yerine gerçek parola yazın.
DATABASE_URL=postgresql://nakis:CHANGE_ME@localhost:5433/nakis
# Yalnızca testler için ayrı veritabanı (NODE_ENV=test iken zorunlu). Asla ana veritabanını göstermeyin.
DATABASE_URL_TEST=postgresql://nakis:CHANGE_ME@localhost:5433/nakis_test

# --- Oturum / kriptografi ---
# En az 32 karakter rastgele gizli değer (oturum IP özetleri ve denetim kayıtları için HMAC anahtarı).
# Üretmek için: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=CHANGE_ME_MIN_32_CHARS

# --- Nesne depolama (S3 uyumlu: geliştirmede MinIO; canlıda R2/S3/Spaces vb.) ---
# Depolama servisinin adresi.
S3_ENDPOINT=http://localhost:9000
# Servis iç ağdaysa imzalı indirmelerin tarayıcıdan erişilebilen HTTPS adresi.
# S3_PRESIGN_ENDPOINT=https://nakis.example.com
# Bölge (MinIO için us-east-1 kalabilir).
S3_REGION=us-east-1
# Erişim anahtarı (yalnızca bu iki kovaya yetkili bir anahtar kullanın).
S3_ACCESS_KEY=CHANGE_ME
# Gizli anahtar.
S3_SECRET_KEY=CHANGE_ME
# ÖZEL kova: ücretli dijital nakış dosyaları ve özel sipariş ekleri. ASLA herkese açık olmamalı.
S3_BUCKET_PRIVATE=nakis-private
# HERKESE AÇIK kova: yalnızca ürün/kategori görselleri.
S3_BUCKET_PUBLIC=nakis-public
# Herkese açık kovanın görsel adresi (tarayıcıdan erişilen taban URL).
S3_PUBLIC_BASE_URL=http://localhost:9000/nakis-public
# true: adres biçimi endpoint/kova (MinIO için true). Çoğu bulut servisi için false.
S3_FORCE_PATH_STYLE=true

# --- E-posta ---
# smtp: gerçekten gönderir | console: gönderme yerine sunucu konsoluna yazar (geliştirme).
EMAIL_TRANSPORT=smtp
# SMTP sunucusu (geliştirmede Mailpit; arayüzü http://localhost:8025).
SMTP_HOST=localhost
# SMTP portu.
SMTP_PORT=1025
# SMTP kullanıcı adı (Mailpit için boş).
SMTP_USER=
# SMTP parolası (Mailpit için boş).
SMTP_PASS=
# Gönderen adresi. Canlıda doğrulanmış adres kullanın. Görünen ad, mağaza ayarından gelir.
SMTP_FROM=no-reply@localhost
# Yeni kişiye özel sipariş taleplerinin iletileceği yönetici e-posta adresi (isteğe bağlı).
ADMIN_NOTIFY_EMAIL=

# --- Ödeme ---
# none: ödeme toplanmaz, sipariş "ödeme bekleniyor" kalır (varsayılan) | simulated: yalnızca geliştirme/test | shopier | iyzico | paytr
PAYMENT_PROVIDER=none
# Shopier OSB kullanıcı adı (Ek Özellikler > Sipariş Bildirimi). PAYMENT_PROVIDER=shopier iken zorunlu.
SHOPIER_OSB_USERNAME=
# Shopier OSB şifresi. İmza anahtarıdır; repoya yazılmaz. PAYMENT_PROVIDER=shopier iken zorunlu.
SHOPIER_OSB_KEY=
# Shopier kişisel erişim anahtarı (PAT). Yalnızca `npm run shopier:sync` kullanır.
SHOPIER_PAT=
# Ürünün kendi Shopier adresi yoksa satın alma düğmesinin açtığı mağaza.
SHOPIER_STORE_URL=https://www.shopier.com/Jagnakis
# Shopier REST kökü.
SHOPIER_API_BASE_URL=https://api.shopier.com/v1
# Sahte ödeme simülasyonu. Yalnızca geliştirmede true olabilir; production'da env doğrulaması buna İZİN VERMEZ.
PAYMENT_SIMULATION_ENABLED=false
# iyzico anahtarları (üye işyeri sözleşmesi sonrası iyzico panelinden alınır).
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# iyzico adresi: sandbox https://sandbox-api.iyzipay.com | canlı https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
# PayTR mağaza bilgileri (PayTR mağaza panelinden alınır).
PAYTR_MERCHANT_ID=
PAYTR_MERCHANT_KEY=
PAYTR_MERCHANT_SALT=

# --- Yönetici hesabı oluşturma (YALNIZCA `npm run admin:create` okur; işiniz bitince bu iki satırı silin) ---
# İlk SUPER_ADMIN e-postası.
ADMIN_BOOTSTRAP_EMAIL=
# İlk SUPER_ADMIN parolası (en az 12 karakter).
ADMIN_BOOTSTRAP_PASSWORD=

# --- İş kuralları ---
# İndirme bağlantısının geçerlilik süresi (saniye).
DOWNLOAD_URL_TTL_SECONDS=300
# Satın alma başına varsayılan indirme hakkı (yönetim panelindeki "politika" ayarı yoksa bu kullanılır).
DOWNLOAD_LIMIT_DEFAULT=5
# Sepet/ödeme stok rezervasyonunun süresi (dakika); dolunca jobs:release-reservations serbest bırakır.
RESERVATION_TTL_MINUTES=30
# Env'de tanımlı genel yükleme üst sınırı (MB). NOT: gerçek sınırlar uç bazında kodda tanımlıdır (bkz. API_DOCUMENTATION.md).
UPLOAD_MAX_MB=50

# Ticaret kuralları (not: bunlar env.ts doğrulamasından geçmez, doğrudan okunur)
# İade edilen siparişin indirme hakları iptal edilsin mi (true/false).
REFUND_REVOKES_DOWNLOADS=true
# Ödemeden kaç gün sonra indirme hakkı sona ersin. 0 veya boş = süresiz.
DOWNLOAD_EXPIRY_DAYS=0
# Zorunlu (>=16 karakter) PAYMENT_SIMULATION_ENABLED=true iken; fallback yok.
PAYMENT_SIMULATION_SECRET=
