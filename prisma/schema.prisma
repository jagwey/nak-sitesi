// Production schema. Money is ALWAYS integer kurus (Int). Never Float/Decimal.
// Orders snapshot everything they need so archiving/changing catalog data never rewrites history.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────────────────── Enums ─────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TokenPurpose {
  EMAIL_VERIFY
  PASSWORD_RESET
}

enum ProductType {
  DIGITAL_EMBROIDERY
  PHYSICAL
  PERSONALIZED
  TEXTILE_PRINT
  DIGITAL_PRINT
  BUNDLE
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum OptionType {
  TEXT
  SELECT
  COLOR
}

enum MetadataSource {
  PARSED
  MANUAL
}

enum DigitalFileStatus {
  ACTIVE
  REPLACED
  DELETED
}

enum ReservationStatus {
  ACTIVE
  CONSUMED
  RELEASED
  EXPIRED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PROCESSING
  IN_PRODUCTION
  SHIPPED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum FulfillmentStatus {
  NOT_REQUIRED
  PENDING
  IN_PROGRESS
  FULFILLED
  CANCELLED
}

enum FulfillmentKind {
  DIGITAL
  PHYSICAL
}

enum ShipmentStatus {
  PENDING
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum CouponType {
  PERCENT
  FIXED
}

enum CustomOrderStatus {
  NEW
  REVIEWING
  QUOTED
  ACCEPTED
  REJECTED
  CANCELLED
  CONVERTED
}

enum MessageAuthor {
  CUSTOMER
  ADMIN
}

enum NotificationChannel {
  EMAIL
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

// ───────────────────────── Auth / RBAC ─────────────────────────

model User {
  id               String     @id @default(cuid())
  email            String     @unique // always stored lower-cased
  passwordHash     String
  name             String?
  phone            String?
  status           UserStatus @default(ACTIVE)
  emailVerifiedAt  DateTime?
  failedLoginCount Int        @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  anonymizedAt     DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  roles         UserRole[]
  sessions      Session[]
  tokens        VerificationToken[]
  addresses     Address[]
  orders        Order[]
  carts         Cart[]
  wishlist      Wishlist?
  entitlements  DownloadEntitlement[]
  customOrders  CustomOrder[]
  notifications Notification[]
  auditLogs     AuditLog[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // SUPER_ADMIN, ADMIN, PRODUCT_MANAGER, ORDER_MANAGER, CUSTOMER
  name        String
  description String?
  system      Boolean  @default(true)
  createdAt   DateTime @default(now())

  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id          String  @id @default(cuid())
  code        String  @unique // e.g. product:write
  description String?

  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique // sha256 of the opaque cookie token
  expiresAt  DateTime
  lastUsedAt DateTime @default(now())
  ipHash     String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id        String       @id @default(cuid())
  userId    String
  purpose   TokenPurpose
  tokenHash String       @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

model Address {
  id                String   @id @default(cuid())
  userId            String
  label             String?
  fullName          String
  phone             String
  line1             String
  line2             String?
  city              String
  district          String
  postalCode        String?
  country           String   @default("TR")
  isDefaultShipping Boolean  @default(false)
  isDefaultBilling  Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ───────────────────────── Catalog ─────────────────────────

model Category {
  id               String           @id @default(cuid())
  slug             String           @unique
  name             String
  description      String?
  image            String?
  imageAlt         String?
  seoTitle         String?
  seoDescription   String?
  featuredType     String? // "digital" | "physical" | "all"
  parentId         String?
  sort             Int              @default(0)
  active           Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  parent           Category?        @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children         Category[]       @relation("CategoryTree")
  products         Product[]
  couponCategories CouponCategory[]

  @@index([parentId])
}

model Collection {
  id          String              @id @default(cuid())
  slug        String              @unique
  title       String
  subtitle    String?
  filterQuery String?
  image       String?
  imageAlt    String?
  sort        Int                 @default(0)
  active      Boolean             @default(true)
  products    ProductCollection[]
}

model ProductCollection {
  productId    String
  collectionId String
  sort         Int        @default(0)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, sort])
}

model Tag {
  id       String       @id @default(cuid())
  slug     String       @unique
  name     String
  products ProductTag[]
}

model ProductTag {
  productId String
  tagId     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([tagId])
}

model Product {
  id                  String        @id @default(cuid())
  slug                String        @unique
  sku                 String        @unique
  type                ProductType
  status              ProductStatus @default(DRAFT)
  name                String
  shortDescription    String        @default("")
  description         String        @default("")
  highlights          String[]
  usageAreas          String[]
  priceKurus          Int
  compareAtPriceKurus Int?
  currency            String        @default("TRY")
  seoTitle            String?
  seoDescription      String?
  personalizable      Boolean       @default(false)
  isNew               Boolean       @default(false)
  isFeatured          Boolean       @default(false)
  isDemo              Boolean       @default(false) // seeded demo data; never real stock/pricing
  shopierUrl          String?
  physicalInfo        Json? // colors, sizes, material, productionTime, careInstructions...
  searchText          String        @default("") // normalized (folded Turkish) text for trigram search
  categoryId          String?
  publishedAt         DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  category       Category?             @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants       ProductVariant[]
  images         ProductImage[]
  options        ProductOption[]
  tags           ProductTag[]
  collections    ProductCollection[]
  bundleItems    BundleItem[]          @relation("Bundle")
  inBundles      BundleItem[]          @relation("BundleMember")
  formats        ProductFormat[]
  embroidery     EmbroideryMetadata?
  digitalFiles   DigitalFile[]
  licenses       ProductLicense[]
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]
  wishlistItems  WishlistItem[]
  couponProducts CouponProduct[]
  entitlements   DownloadEntitlement[]

  @@index([status, type])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([publishedAt])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "Product_searchText_trgm_idx")
}

model ProductVariant {
  id           String        @id @default(cuid())
  productId    String
  sku          String        @unique
  name         String
  options      Json          @default("{}") // e.g. {"size":"Aile Seti","color":"Ekru"}
  priceKurus   Int? // overrides Product.priceKurus when set
  active       Boolean       @default(true)
  sort         Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  digitalFiles DigitalFile[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([productId])
}

model ProductImage {
  id         String  @id @default(cuid())
  productId  String
  storageKey String? // object key in the public bucket (null for static /images/* assets)
  url        String
  alt        String  @default("")
  caption    String  @default("")
  sort       Int     @default(0)
  product    Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, sort])
}

model ProductOption {
  id              String     @id @default(cuid())
  productId       String
  key             String // e.g. "monogram", "threadColor"
  label           String
  type            OptionType @default(TEXT)
  required        Boolean    @default(false)
  minLength       Int?
  maxLength       Int?
  choices         Json?
  priceDeltaKurus Int        @default(0)
  sort            Int        @default(0)
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, key])
}

model BundleItem {
  id       String  @id @default(cuid())
  bundleId String
  itemId   String
  quantity Int     @default(1)
  bundle   Product @relation("Bundle", fields: [bundleId], references: [id], onDelete: Cascade)
  item     Product @relation("BundleMember", fields: [itemId], references: [id], onDelete: Restrict)

  @@unique([bundleId, itemId])
  @@index([itemId])
}

// ───────────────────────── Embroidery domain ─────────────────────────

model FileFormat {
  id          String  @id @default(cuid())
  code        String  @unique // VP3, PES, DST, JEF, HUS, EXP, XXX, VIP, PEC, PCS, SEW, ART
  name        String?
  description String?
  extension   String
  sort        Int     @default(0)

  models       MachineModelFormat[]
  products     ProductFormat[]
  digitalFiles DigitalFile[]
  cartItems    CartItem[]
}

model ProductFormat {
  productId String
  formatId  String
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  format    FileFormat @relation(fields: [formatId], references: [id], onDelete: Restrict)

  @@id([productId, formatId])
  @@index([formatId])
}

model MachineBrand {
  id     String         @id @default(cuid())
  slug   String         @unique
  name   String         @unique
  sort   Int            @default(0)
  models MachineModel[]
}

model MachineModel {
  id      String               @id @default(cuid())
  brandId String
  name    String
  notes   String?
  brand   MachineBrand         @relation(fields: [brandId], references: [id], onDelete: Cascade)
  formats MachineModelFormat[]
  hoops   MachineModelHoop[]

  @@unique([brandId, name])
}

model MachineModelFormat {
  modelId   String
  formatId  String
  preferred Boolean      @default(false)
  model     MachineModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  format    FileFormat   @relation(fields: [formatId], references: [id], onDelete: Cascade)

  @@id([modelId, formatId])
  @@index([formatId])
}

model HoopSize {
  id       String @id @default(cuid())
  label    String @unique // "13x18 cm"
  widthMm  Int
  heightMm Int

  models       MachineModelHoop[]
  metadata     EmbroideryMetadata[]
  digitalFiles DigitalFile[]
}

model MachineModelHoop {
  modelId String
  hoopId  String
  model   MachineModel @relation(fields: [modelId], references: [id], onDelete: Cascade)
  hoop    HoopSize     @relation(fields: [hoopId], references: [id], onDelete: Cascade)

  @@id([modelId, hoopId])
  @@index([hoopId])
}

model EmbroideryMetadata {
  id                    String         @id @default(cuid())
  productId             String         @unique
  designWidthMm         Int?
  designHeightMm        Int?
  stitchCount           Int?
  colorCount            Int?
  colorChanges          Int?
  threadColors          Json? // [{step,name,code,hex,stitches}]
  technique             String?
  fabricRecommendations String?
  usageInstructions     String[]
  downloadTerms         String?
  hoopSizeId            String?
  metadataSource        MetadataSource @default(MANUAL)
  verified              Boolean        @default(false)
  updatedAt             DateTime       @updatedAt
  product               Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  hoopSize              HoopSize?      @relation(fields: [hoopSizeId], references: [id], onDelete: SetNull)
}

model DigitalFile {
  id           String            @id @default(cuid())
  productId    String
  variantId    String?
  formatId     String
  hoopSizeId   String?
  storageKey   String            @unique // PRIVATE bucket key - never exposed
  originalName String
  sizeBytes    Int
  sha256       String
  version      Int               @default(1)
  isCurrent    Boolean           @default(true)
  parsedMeta   Json?
  status       DigitalFileStatus @default(ACTIVE)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  // Restrict: files referenced by entitlements can never be hard-deleted; mark status instead.
  product      Product               @relation(fields: [productId], references: [id], onDelete: Restrict)
  variant      ProductVariant?       @relation(fields: [variantId], references: [id], onDelete: SetNull)
  format       FileFormat            @relation(fields: [formatId], references: [id], onDelete: Restrict)
  hoopSize     HoopSize?             @relation(fields: [hoopSizeId], references: [id], onDelete: SetNull)
  entitlements DownloadEntitlement[]

  @@index([productId, formatId, isCurrent])
  @@index([sha256])
}

model License {
  id              String @id @default(cuid())
  code            String @unique // PERSONAL, SMALL_BUSINESS
  name            String
  description     String?
  priceDeltaKurus Int    @default(0)
  sort            Int    @default(0)

  products  ProductLicense[]
  cartItems CartItem[]
}

model ProductLicense {
  productId       String
  licenseId       String
  priceDeltaKurus Int? // overrides License.priceDeltaKurus for this product
  product         Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  license         License @relation(fields: [licenseId], references: [id], onDelete: Restrict)

  @@id([productId, licenseId])
}

// ───────────────────────── Inventory ─────────────────────────

model Inventory {
  id                String                 @id @default(cuid())
  productId         String?                @unique
  variantId         String?                @unique
  onHand            Int                    @default(0)
  reserved          Int                    @default(0)
  lowStockThreshold Int                    @default(3)
  updatedAt         DateTime               @updatedAt
  product           Product?               @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant           ProductVariant?        @relation(fields: [variantId], references: [id], onDelete: Cascade)
  reservations      InventoryReservation[]
}

model InventoryReservation {
  id          String            @id @default(cuid())
  inventoryId String
  cartId      String?
  orderId     String?
  quantity    Int
  status      ReservationStatus @default(ACTIVE)
  expiresAt   DateTime
  createdAt   DateTime          @default(now())
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  cart        Cart?             @relation(fields: [cartId], references: [id], onDelete: SetNull)
  order       Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([cartId])
  @@index([orderId])
  @@index([inventoryId])
}

// ───────────────────────── Cart / Wishlist ─────────────────────────

model Cart {
  id             String                 @id @default(cuid())
  userId         String?                @unique
  guestTokenHash String?                @unique
  couponCode     String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  user           User?                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  items          CartItem[]
  reservations   InventoryReservation[]
}

model CartItem {
  id              String          @id @default(cuid())
  cartId          String
  productId       String
  variantId       String?
  formatId        String?
  licenseId       String?
  personalization Json?
  quantity        Int             @default(1)
  createdAt       DateTime        @default(now())
  cart            Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product         Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  format          FileFormat?     @relation(fields: [formatId], references: [id], onDelete: SetNull)
  license         License?        @relation(fields: [licenseId], references: [id], onDelete: SetNull)

  @@index([cartId])
  @@index([productId])
}

model Wishlist {
  id        String         @id @default(cuid())
  userId    String         @unique
  createdAt DateTime       @default(now())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
}

model WishlistItem {
  wishlistId String
  productId  String
  createdAt  DateTime @default(now())
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([wishlistId, productId])
  @@index([productId])
}

// ───────────────────────── Orders / Payments / Shipping ─────────────────────────

model Order {
  id                        String            @id @default(cuid())
  number                    String            @unique // human order number, e.g. TB-2026-000123
  userId                    String?
  email                     String
  phone                     String?
  status                    OrderStatus       @default(PENDING_PAYMENT)
  paymentStatus             PaymentStatus     @default(UNPAID)
  digitalFulfillmentStatus  FulfillmentStatus @default(NOT_REQUIRED)
  physicalFulfillmentStatus FulfillmentStatus @default(NOT_REQUIRED)
  currency                  String            @default("TRY")
  subtotalKurus             Int
  discountKurus             Int               @default(0)
  shippingKurus             Int               @default(0)
  taxKurus                  Int               @default(0)
  totalKurus                Int
  couponCode                String? // snapshot
  shippingAddress           Json? // snapshot
  billingAddress            Json? // snapshot
  customerNote              String?
  guestAccessTokenHash      String?           @unique // lets guests view their order via emailed link
  placedAt                  DateTime          @default(now())
  paidAt                    DateTime?
  cancelledAt               DateTime?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)
  items        OrderItem[]
  payments     Payment[]
  shipments    Shipment[]
  redemptions  CouponRedemption[]
  reservations InventoryReservation[]
  customOrder  CustomOrder?

  @@index([userId, createdAt])
  @@index([email])
  @@index([status, createdAt])
  @@index([paymentStatus])
}

model OrderItem {
  id                String            @id @default(cuid())
  orderId           String
  productId         String?
  variantId         String?
  kind              FulfillmentKind
  productName       String
  sku               String
  variantName       String?
  format            String?
  license           String?
  unitPriceKurus    Int
  quantity          Int
  lineTotalKurus    Int
  personalization   Json?
  fulfillmentStatus FulfillmentStatus @default(PENDING)
  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // SetNull: archiving/removing catalog rows must never break historical orders (snapshot columns above).
  product           Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variant           ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: SetNull)
  entitlements      DownloadEntitlement[]

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id                String        @id @default(cuid())
  orderId           String
  provider          String // simulated | iyzico | paytr
  providerPaymentId String?       @unique
  status            PaymentStatus @default(PENDING)
  amountKurus       Int
  currency          String        @default("TRY")
  idempotencyKey    String        @unique
  raw               Json? // minimal provider response; never card data
  failureReason     String?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String
  payloadHash String
  receivedAt  DateTime  @default(now())
  processedAt DateTime?
  error       String?

  @@unique([provider, eventId])
}

model Shipment {
  id                String         @id @default(cuid())
  orderId           String
  carrier           String?
  trackingNumber    String?
  status            ShipmentStatus @default(PENDING)
  shippingFeeKurus  Int            @default(0)
  estimatedPrepDays Int?
  address           Json?
  shippedAt         DateTime?
  deliveredAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  order             Order          @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// ───────────────────────── Digital delivery ─────────────────────────

model DownloadEntitlement {
  id            String        @id @default(cuid())
  orderItemId   String
  userId        String?
  productId     String
  digitalFileId String?
  remaining     Int
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokeReason  String?
  createdAt     DateTime      @default(now())
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  user          User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  product       Product       @relation(fields: [productId], references: [id], onDelete: Restrict)
  digitalFile   DigitalFile?  @relation(fields: [digitalFileId], references: [id], onDelete: Restrict)
  logs          DownloadLog[]

  @@index([userId])
  @@index([orderItemId])
  @@index([digitalFileId])
}

model DownloadLog {
  id            String              @id @default(cuid())
  entitlementId String
  ipHash        String?
  userAgent     String?
  createdAt     DateTime            @default(now())
  entitlement   DownloadEntitlement @relation(fields: [entitlementId], references: [id], onDelete: Cascade)

  @@index([entitlementId, createdAt])
}

// ───────────────────────── Coupons ─────────────────────────

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique // stored upper-case
  type             CouponType
  value            Int // PERCENT: 1-100, FIXED: kurus
  minSubtotalKurus Int                @default(0)
  usageLimit       Int?
  perCustomerLimit Int?
  usedCount        Int                @default(0)
  startsAt         DateTime?
  endsAt           DateTime?
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  products         CouponProduct[]
  categories       CouponCategory[]
  redemptions      CouponRedemption[]
}

model CouponProduct {
  couponId  String
  productId String
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([couponId, productId])
}

model CouponCategory {
  couponId   String
  categoryId String
  coupon     Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([couponId, categoryId])
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  orderId       String   @unique // one redemption per order
  userId        String?
  email         String
  discountKurus Int
  createdAt     DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId, email])
  @@index([couponId, userId])
}

// ───────────────────────── Custom orders ─────────────────────────

model CustomOrder {
  id           String                  @id @default(cuid())
  userId       String?
  name         String
  email        String
  phone        String?
  text         String
  threadColor  String?
  size         String?
  machineModel String?
  format       String?
  notes        String?
  initials     String?
  productType  String?
  deadline     String? // ISO date (YYYY-MM-DD) chosen by the customer
  budgetKurus  Int?
  prepDays     Int?
  quoteValidUntil String? // ISO date (YYYY-MM-DD), inclusive
  consentAt    DateTime?
  accessTokenHash String? @unique // guest quote link; only the sha256 is stored
  accessTokenExpiresAt DateTime?
  status       CustomOrderStatus       @default(NEW)
  quoteKurus   Int?
  quoteNote    String?
  quotedAt     DateTime?
  orderId      String?                 @unique
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order        Order?                  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  attachments  CustomOrderAttachment[]
  messages     CustomOrderMessage[]

  @@index([status, createdAt])
  @@index([email])
  @@index([userId])
}

model CustomOrderAttachment {
  id            String      @id @default(cuid())
  customOrderId String
  storageKey    String      @unique // PRIVATE bucket
  originalName  String
  mimeType      String
  sizeBytes     Int
  createdAt     DateTime    @default(now())
  customOrder   CustomOrder @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId])
}

model CustomOrderMessage {
  id            String        @id @default(cuid())
  customOrderId String
  authorType    MessageAuthor
  authorUserId  String?
  body          String
  createdAt     DateTime      @default(now())
  customOrder   CustomOrder   @relation(fields: [customOrderId], references: [id], onDelete: Cascade)

  @@index([customOrderId, createdAt])
}

// ───────────────────────── Platform ─────────────────────────

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json // shape validated in the application layer (zod)
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String // e.g. product.update
  entity      String
  entityId    String?
  diff        Json? // secrets redacted
  ipHash      String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([actorUserId, createdAt])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String?
  type      String // verify_email, password_reset, order_created ...
  channel   NotificationChannel @default(EMAIL)
  toAddress String?
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  error     String?
  sentAt    DateTime?
  createdAt DateTime            @default(now())
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status, createdAt])
}

model RateLimit {
  id          String   @id @default(cuid())
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @default(now())

  @@index([windowStart])
}
